# 飞书多维表格凭证
# 在飞书开放平台 https://open.feishu.cn/app 创建企业自建应用后获取
# 1. 创建应用：开发者后台 -> 企业自建应用 -> 创建企业自建应用
# 2. 权限管理：搜索「多维表格」相关权限，勾选：
#    - bitable:app:readonly    （读取）
#    - bitable:app             （读写，Bitable 完整权限）
#    - bitable:app:write       （可选，覆盖写入）
# 3. 版本管理与发布：创建一个版本，提交发布（企业内部审核通过即可）
# 4. 把 app_id 和 app_secret 填到下面
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# 多维表格凭证（已建好）
# Fill these identifiers from your own internal Feishu Bitable deployment.
LARK_BITABLE_APP_TOKEN=your_bitable_app_token
LARK_BITABLE_TABLE_ID=your_table_id

# 服务端口（默认 8787）
PORT=8787

# 是否开启离线降级（飞书 API 失败时本地 JSON 暂存）
# 1=开启 0=关闭
LOCAL_FALLBACK=1

# ===== 飞书 SSO 登录（authen/v2）=====
# 应用能力需含「网页应用」，并在「安全设置」登记回调 URL。
# 换 token 会原样回传此 redirect_uri（缺失报 20063）。默认本机 127.0.0.1。
LARK_LOGIN_REDIRECT_URI=http://127.0.0.1:8787/api/auth/callback
# 新版「网页应用」登录流程已取消 scope；仅老式授权应用才需填 LARK_LOGIN_SCOPE（留空即不传）。
# LARK_LOGIN_SCOPE=authen:user.id:read

# ===== 机器人单聊消息（活动提醒，im:message:send_as_bot）=====
# 无需额外变量：复用上面的 APP_ID/APP_SECRET + 「机器人」能力 + im:message:send_as_bot 权限。

# ===== 活动开始提醒定时任务 =====
# 关闭整个提醒扫描：0（默认启用）
REMINDERS_ENABLED=1
# cron 表达式（默认每小时整点）；测试可临时改 '*/1 * * * *' 每分钟
REMINDER_CRON=0 * * * *
# 活动开始前多少小时提醒（默认 24）；依赖 activities.start_at
REMIND_AHEAD_HOURS=24

# ===== 会话安全 =====
# 生产务必设为强随机串；dev-login 仅非生产可用
# SESSION_SECRET=
# 生产设为 production（关闭 dev-login 与旧 x-user-role 头）
# NODE_ENV=production
# 显式允许 dev-login（非生产默认已开）：ALLOW_DEV_LOGIN=1
# ALLOW_DEV_LOGIN=
